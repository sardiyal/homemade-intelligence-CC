# =============================================================================
# Homemade Intelligence — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual `.env` file to version control.
# =============================================================================

# ----- LLM API Keys -----
# ANTHROPIC_API_KEY=sk-ant-...
# ALPHA_VANTAGE_API_KEY=your_key   # free at alphavantage.co
# BEA_API_KEY=your_key             # free at apps.bea.gov/api/signup/
# BLS_API_KEY=your_key             # optional, free at bls.gov/developers/

# ----- News / Data API Keys -----
# FRED_API_KEY=

# ----- Database -----
# DATABASE_URL=sqlite:///./data/homemade_intelligence.db
# CHROMA_PERSIST_DIR=./data/chroma

# ----- Server -----
# FRONTEND_URL=http://localhost:3000
# LOG_LEVEL=INFO
